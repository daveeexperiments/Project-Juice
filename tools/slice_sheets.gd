extends SceneTree

## Slice every delivered sheet into individual pieces.
##
##   godot --headless --path . --script tools/slice_sheets.gd
##
## Safe to re-run. It writes three things:
##
## - `art/manifest/<sheet>.tres` -- the piece list and the collision each one gets. Decisions
##   already recorded there are KEPT; only the measured geometry is refreshed.
## - `art/atlas/<family>/<id>.tres` -- one AtlasTexture per piece. Internal: the piece SCENES reference
##   its own in Godot's FileSystem dock with a thumbnail, and can be dragged straight into a
##   scene. These point AT the sheet rather than copying pixels out of it, so 166 of them cost
##   almost nothing and there is only ever one copy of the art.
## - `docs/SHEET_REPORT.md` -- what was found, for reviewing the guesses away from the editor.
##
## Nothing here writes to a level. Placement is a separate, human job.

const FAMILIES: Dictionary = {
	"terrain": "res://art/source/terrain",
	"props": "res://art/source/props",
}

const MANIFEST_DIR: String = "res://art/manifest"
const PIECE_DIR: String = "res://art/atlas"
const REPORT_PATH: String = "res://docs/SHEET_REPORT.md"


func _initialize() -> void:
	var slicer: SheetSlicer = SheetSlicer.new()
	var report: Array[String] = []
	report.append("# What the slicer found")
	report.append("")
	report.append("Generated by `tools/slice_sheets.gd`. Re-running keeps every decision already")
	report.append("recorded in `art/manifest/`, so this file is safe to regenerate at any time.")
	report.append("")

	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(MANIFEST_DIR))

	var total_pieces: int = 0
	var total_unreviewed: int = 0

	for family: String in FAMILIES:
		var folder: String = FAMILIES[family] as String
		var out_dir: String = "%s/%s" % [PIECE_DIR, family]
		DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(out_dir))
		# Clear the previous run's textures first. Ids are positional, so if a slicing change
		# alters how many pieces a sheet has, the leftovers from the old run would sit alongside
		# the new ones looking exactly as legitimate.
		_clear_generated(out_dir)

		for sheet_path: String in _sheets_in(folder):
			var stem: String = sheet_path.get_file().get_basename().to_lower().replace(" ", "_")
			var manifest_path: String = "%s/%s.tres" % [MANIFEST_DIR, stem]

			var existing: SheetManifest = null
			if ResourceLoader.exists(manifest_path):
				existing = ResourceLoader.load(manifest_path, "", ResourceLoader.CACHE_MODE_IGNORE) as SheetManifest

			var manifest: SheetManifest = slicer.slice(sheet_path, family, existing)
			if manifest == null:
				continue

			var saved: int = ResourceSaver.save(manifest, manifest_path)
			if saved != OK:
				printerr("could not write %s (error %d)" % [manifest_path, saved])
				quit(1)
				return

			var written: int = _write_piece_textures(manifest, family)
			total_pieces += manifest.pieces.size()
			total_unreviewed += manifest.unreviewed_count()

			_print_sheet(manifest, written)
			_append_sheet_report(report, manifest)

	report.append("")
	report.append("## Reviewing a guess")
	report.append("")
	report.append("Open the manifest in `art/manifest/`, pick a piece, and set `kind` to what it")
	report.append("should collide as. Then tick `reviewed`. The slicer never overwrites either")
	report.append("field, so a re-run costs you nothing.")
	report.append("")
	report.append("| kind | collides as | for |")
	report.append("|---|---|---|")
	report.append("| `POLYGON` | the traced outline, closed by the ball radius | terrain you stand on |")
	report.append("| `CIRCLE` | one radius | gears, pulleys, wheels, saw blades |")
	report.append("| `RECT` | the region's box | beams, straight pipes, platforms |")
	report.append("| `ANNULUS` | two radii, inner surface solid | a ring the ball travels inside |")
	report.append("| `NONE` | nothing at all | decoration, in every placement |")

	var file: FileAccess = FileAccess.open(REPORT_PATH, FileAccess.WRITE)
	if file != null:
		file.store_string("\n".join(report) + "\n")
		file.close()

	print("")
	print("%d pieces across %d sheets. %d still unreviewed." % [total_pieces, _sheet_count(), total_unreviewed])
	print("manifests in art/manifest/, one texture per piece in art/atlas/, report in docs/SHEET_REPORT.md")
	quit(0)


# ---------------------------------------------------------------- one texture per piece

## Write an AtlasTexture per piece, so each element is browsable on its own.
func _write_piece_textures(manifest: SheetManifest, family: String) -> int:
	var sheet: Texture2D = ResourceLoader.load(manifest.sheet) as Texture2D
	if sheet == null:
		printerr("could not load %s as a texture -- has the project been imported?" % manifest.sheet)
		return 0

	var written: int = 0
	for piece: PieceEntry in manifest.pieces:
		var atlas: AtlasTexture = AtlasTexture.new()
		atlas.atlas = sheet
		atlas.region = Rect2(piece.region)
		var path: String = "%s/%s/%s.tres" % [PIECE_DIR, family, piece.id]
		if ResourceSaver.save(atlas, path) == OK:
			written += 1
	return written


# ---------------------------------------------------------------- reporting

func _print_sheet(manifest: SheetManifest, textures: int) -> void:
	var counts: Dictionary = manifest.counts_by_kind()
	var parts: Array[String] = []
	for kind: String in counts:
		parts.append("%d %s" % [counts[kind], kind])
	print("")
	print("%s  --  %d pieces (%s), %d textures" % [
		manifest.sheet.get_file(), manifest.pieces.size(), ", ".join(parts), textures,
	])

	var verts: Array[int] = []
	for piece: PieceEntry in manifest.pieces:
		verts.append(piece.vertex_count)
	verts.sort()
	if not verts.is_empty():
		print("    outline vertices: median %d, worst %d" % [verts[verts.size() / 2], verts[-1]])


func _append_sheet_report(report: Array[String], manifest: SheetManifest) -> void:
	report.append("## %s" % manifest.sheet.get_file())
	report.append("")
	report.append("%d pieces, traced at epsilon %.1f." % [manifest.pieces.size(), manifest.epsilon])
	report.append("")
	report.append("| id | region | size | kind | guessed | verts | solidity | box fill | circularity |")
	report.append("|---|---|---|---|---|---|---|---|---|")
	for piece: PieceEntry in manifest.pieces:
		report.append("| `%s` | %d, %d | %d x %d | %s | %s | %d | %.2f | %.2f | %.2f |" % [
			piece.id,
			piece.region.position.x, piece.region.position.y,
			piece.region.size.x, piece.region.size.y,
			PieceEntry.kind_name(piece.kind),
			PieceEntry.kind_name(piece.guessed),
			piece.vertex_count,
			piece.solidity, piece.box_fill, piece.circularity,
		])
	report.append("")


# ---------------------------------------------------------------- file discovery

func _sheets_in(folder: String) -> Array[String]:
	var found: Array[String] = []
	var dir: DirAccess = DirAccess.open(folder)
	if dir == null:
		return found
	for name: String in dir.get_files():
		# Godot reports an imported PNG as "x.png.import" in an exported build and "x.png" in the
		# project folder; accept the plain name and ignore the sidecar.
		if name.get_extension().to_lower() == "png":
			found.append("%s/%s" % [folder, name])
	found.sort()
	return found


## Remove the generated piece textures from one folder.
##
## Deliberately narrow: only `.tres` files, only in `art/atlas/<family>`, which this script is
## the sole writer of. It does not recurse and it does not touch the source art.
func _clear_generated(dir_path: String) -> void:
	var dir: DirAccess = DirAccess.open(dir_path)
	if dir == null:
		return
	for name: String in dir.get_files():
		if name.get_extension().to_lower() == "tres":
			dir.remove(name)


func _sheet_count() -> int:
	var count: int = 0
	for family: String in FAMILIES:
		count += _sheets_in(FAMILIES[family] as String).size()
	return count
